# ==============================================================================
# EventAI Pro — Staging Environment Configuration Template
# FILE: env.staging.example
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env.staging (or set environment variables in your deployment runner).
# Never commit real secrets or production passwords into version control.
# ==============================================================================

# Flask Environment Profile ('staging' enables StagingConfig)
FLASK_ENV=staging
PORT=5000

# Cryptographic Session Secret Key
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_hex_key_for_staging

# Database URI (Isolated Staging Database)
# DO NOT point to production instance/event_management.db
DATABASE_URI=sqlite:///instance/staging.db

# Canonical Host / Origin for Staging
# For local Windows rehearsal: http://127.0.0.1:5000
# For Linux staging VM: https://staging.eventai.internal
CANONICAL_DOMAIN=http://127.0.0.1:5000

# Artificial Intelligence Engine
# Staging operates with offline mock fallback by default to avoid external API quota consumption
ENABLE_AI_FALLBACK_MOCK=True
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RATE_LIMIT_PER_MINUTE=60

# Session Cookie Security
# Set to 'True' if staging terminates behind HTTPS/TLS; 'False' if testing over plain HTTP on localhost
SESSION_COOKIE_SECURE=False

# Upload Payload Limit (16 MB)
MAX_CONTENT_LENGTH=16777216

